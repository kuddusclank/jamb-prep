# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Native API (required for static account screens; use a verified staging Worker)
NEXT_PUBLIC_API_BASE_URL="https://your-staging-api.workers.dev"

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# Paystack Billing (Sandbox / Live)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="your-paystack-public-key"
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"

# Optional standard monthly renewal plan; secrets belong only in Worker bindings
PAYSTACK_PLAN_CODE="your-test-plan-code"
